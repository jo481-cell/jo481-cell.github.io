{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "npm ci --omit=dev",
  "outputDirectory": ".",
  "functions": {
    "api/community.ts": {
      "maxDuration": 60
    }
  },
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/:game(the-legend-of-zelda|adventure-of-link|a-link-to-the-past|links-awakening|ocarina-of-time|majoras-mask|oracle-of-ages|oracle-of-seasons|four-swords|the-wind-waker|four-swords-adventures|the-minish-cap|twilight-princess|phantom-hourglass|spirit-tracks|skyward-sword|a-link-between-worlds|tri-force-heroes|echoes-of-wisdom)/",
      "destination": "/series/:game/",
      "permanent": true
    },
    {
      "source": "/:locale(fr|es|ja|zh)/:game(the-legend-of-zelda|adventure-of-link|a-link-to-the-past|links-awakening|ocarina-of-time|majoras-mask|oracle-of-ages|oracle-of-seasons|four-swords|the-wind-waker|four-swords-adventures|the-minish-cap|twilight-princess|phantom-hourglass|spirit-tracks|skyward-sword|a-link-between-worlds|tri-force-heroes|echoes-of-wisdom)/",
      "destination": "/:locale/series/:game/",
      "permanent": true
    },
    {
      "source": "/:alias(walkthrough|walkthroughs|guides|maps)/",
      "destination": "/games/",
      "permanent": true
    },
    {
      "source": "/:locale(fr|es|ja|zh)/:alias(walkthrough|walkthroughs|guides|maps)/",
      "destination": "/:locale/games/",
      "permanent": true
    },
    {
      "source": "/:game(the-legend-of-zelda|adventure-of-link|a-link-to-the-past|links-awakening|ocarina-of-time|majoras-mask|oracle-of-ages|oracle-of-seasons|four-swords|the-wind-waker|four-swords-adventures|the-minish-cap|twilight-princess|phantom-hourglass|spirit-tracks|skyward-sword|a-link-between-worlds|tri-force-heroes|echoes-of-wisdom)",
      "destination": "/series/:game/",
      "permanent": true
    },
    {
      "source": "/:locale(fr|es|ja|zh)/:game(the-legend-of-zelda|adventure-of-link|a-link-to-the-past|links-awakening|ocarina-of-time|majoras-mask|oracle-of-ages|oracle-of-seasons|four-swords|the-wind-waker|four-swords-adventures|the-minish-cap|twilight-princess|phantom-hourglass|spirit-tracks|skyward-sword|a-link-between-worlds|tri-force-heroes|echoes-of-wisdom)",
      "destination": "/:locale/series/:game/",
      "permanent": true
    },
    {
      "source": "/:alias(walkthrough|walkthroughs|guides|maps)",
      "destination": "/games/",
      "permanent": true
    },
    {
      "source": "/:locale(fr|es|ja|zh)/:alias(walkthrough|walkthroughs|guides|maps)",
      "destination": "/:locale/games/",
      "permanent": true
    },
    {
      "source": "/:page(contact|about)/",
      "destination": "/privacy/#contact",
      "permanent": false
    },
    {
      "source": "/:locale(fr|es|ja|zh)/:page(contact|about)/",
      "destination": "/:locale/privacy/#contact",
      "permanent": false
    },
    {
      "source": "/:page(contact|about)",
      "destination": "/privacy/#contact",
      "permanent": false
    },
    {
      "source": "/:locale(fr|es|ja|zh)/:page(contact|about)",
      "destination": "/:locale/privacy/#contact",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), autoplay=(self \"https://www.youtube-nocookie.com\"), fullscreen=(self \"https://www.youtube-nocookie.com\")"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com https://challenges.cloudflare.com https://www.youtube.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https:; media-src 'self' blob:; connect-src 'self' https://cloudflareinsights.com https://challenges.cloudflare.com; frame-src https://www.youtube-nocookie.com https://challenges.cloudflare.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/assets/:file([a-zA-Z0-9_-]+-[a-zA-Z0-9_-]{8,}\\.(?:js|css))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "missing": [
        {
          "type": "host",
          "value": "hyruleatlas.com"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    }
  ]
}
